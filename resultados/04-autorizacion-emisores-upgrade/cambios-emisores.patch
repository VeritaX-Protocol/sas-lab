     /// # Returns
     ///
     /// Returns the next expected nonce (`u64`) for the given attester.
+    /// Lab 02: cualquiera puede renovar el TTL de una attestation (y de la instancia) pagando la renta.
+    /// No cambia datos ni requiere autorización: solo gasta la tarifa de quien llama.
+    pub fn extend_attestation_ttl(env: Env, attestation_uid: BytesN<32>) -> Result<(), errors::Error> {
+        let key = state::DataKey::AttestationUID(attestation_uid);
+        if !env.storage().persistent().has(&key) {
+            return Err(errors::Error::AttestationNotFound);
+        }
+        utils::bump_persistent(&env, &key);
+        utils::bump_instance(&env);
+        Ok(())
+    }
+
+    /// Lab 04: añade (o reactiva) un emisor en un schema. Solo admin o la autoridad del schema.
+    pub fn add_issuer(env: Env, caller: Address, schema_uid: BytesN<32>, issuer: Address) -> Result<(), errors::Error> {
+        issuers::add(&env, caller, schema_uid, issuer)
+    }
+
+    /// Lab 04: retira un emisor. No emite más; sus certificados anteriores siguen válidos.
+    pub fn retire_issuer(env: Env, caller: Address, schema_uid: BytesN<32>, issuer: Address) -> Result<(), errors::Error> {
+        issuers::retire(&env, caller, schema_uid, issuer)
+    }
+
+    pub fn is_active_issuer(env: Env, schema_uid: BytesN<32>, issuer: Address) -> bool {
+        issuers::status(&env, &schema_uid, &issuer) == state::IssuerStatus::Active
+    }
+
+    pub fn issuer_status(env: Env, schema_uid: BytesN<32>, issuer: Address) -> state::IssuerStatus {
+        issuers::status(&env, &schema_uid, &issuer)
+    }
+
+    pub fn list_issuers(env: Env, schema_uid: BytesN<32>) -> soroban_sdk::Vec<Address> {
+        issuers::list(&env, &schema_uid)
+    }
+
+    /// Lab 04: reemplaza el Wasm conservando el estado. Solo `admin`.
+    pub fn upgrade(env: Env, new_wasm_hash: BytesN<32>) -> Result<(), errors::Error> {
+        let admin: Address = env.storage().instance().get(&DataKey::Admin).ok_or(errors::Error::AdminNotSet)?;
+        admin.require_auth();
+        env.deployer().update_current_contract_wasm(new_wasm_hash);
+        Ok(())
+    }
+
+    /// Lab 04: versión visible del código desplegado.
+    pub fn version(_env: Env) -> u32 {
+        if cfg!(feature = "v2") { 2 } else { 1 }
+    }
+
     pub fn get_attester_nonce(env: Env, attester: Address) -> u64 {
         utils::get_next_nonce(&env, &attester)
     }
