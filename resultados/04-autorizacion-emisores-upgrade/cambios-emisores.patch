@@ -0,0 +1,50 @@
+//! Lab 04: resolver con lista de emisores por schema (alternativa a ponerla en el núcleo).
+//! Prototipo para medir costo y tamaño de Wasm. `onattest` solo deja pasar a emisores activos.
+use crate::interface::{ResolverAttestationData, ResolverError, ResolverInterface, ResolverMetadata, ResolverType};
+use soroban_sdk::{contract, contractimpl, contracttype, Address, BytesN, Env, String};
+
+#[contracttype]
+pub enum K {
+    Admin,
+    Emisor(BytesN<32>, Address),
+}
+
+#[contract]
+pub struct IssuerResolver;
+
+const TTL: u32 = 3_110_000;
+
+#[contractimpl]
+impl IssuerResolver {
+    pub fn init(env: Env, admin: Address) {
+        if env.storage().instance().has(&K::Admin) { panic!("ya iniciado") }
+        admin.require_auth();
+        env.storage().instance().set(&K::Admin, &admin);
+    }
+    pub fn set_issuer(env: Env, schema_uid: BytesN<32>, issuer: Address, activo: bool) {
+        let admin: Address = env.storage().instance().get(&K::Admin).unwrap();
+        admin.require_auth();
+        let k = K::Emisor(schema_uid, issuer);
+        env.storage().persistent().set(&k, &activo);
+        env.storage().persistent().extend_ttl(&k, TTL / 6, TTL);
+        env.storage().instance().extend_ttl(TTL / 6, TTL);
+    }
+}
+
+#[contractimpl]
+impl ResolverInterface for IssuerResolver {
+    fn onattest(env: Env, a: ResolverAttestationData) -> Result<bool, ResolverError> {
+        let activo: bool = env.storage().persistent().get(&K::Emisor(a.schema_uid, a.attester)).unwrap_or(false);
+        Ok(activo)
+    }
+    fn onresolve(_env: Env, _uid: BytesN<32>, _attester: Address) -> Result<(), ResolverError> { Ok(()) }
+    fn onrevoke(_env: Env, _a: ResolverAttestationData) -> Result<bool, ResolverError> { Ok(true) }
+    fn metadata(env: Env) -> ResolverMetadata {
+        ResolverMetadata {
+            name: String::from_str(&env, "Issuer Resolver"),
+            version: String::from_str(&env, "lab04"),
+            description: String::from_str(&env, "Lista de emisores por schema"),
+            resolver_type: ResolverType::Custom,
+        }
+    }
+}
