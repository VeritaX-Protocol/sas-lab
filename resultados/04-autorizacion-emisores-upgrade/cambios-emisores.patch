@@ -0,0 +1,65 @@
+//! Lab 04: lista de emisores por schema, en el núcleo. Prototipo para medir, no el contrato del sprint.
+//! Un schema con lista (aunque todos estén retirados) está restringido; sin lista, se comporta como el original.
+use crate::errors::Error;
+use crate::state::{DataKey, IssuerStatus};
+use crate::utils;
+use soroban_sdk::{Address, BytesN, Env, Vec};
+
+pub fn is_admin(env: &Env, a: &Address) -> bool {
+    env.storage().instance().get::<DataKey, Address>(&DataKey::Admin).map_or(false, |x| &x == a)
+}
+
+pub fn status(env: &Env, schema_uid: &BytesN<32>, issuer: &Address) -> IssuerStatus {
+    env.storage().persistent().get(&DataKey::Issuer(schema_uid.clone(), issuer.clone())).unwrap_or(IssuerStatus::NotListed)
+}
+
+/// Solo `admin` o la autoridad del schema cambian la lista.
+fn gestionar(env: &Env, caller: &Address, schema_uid: &BytesN<32>) -> Result<(), Error> {
+    caller.require_auth();
+    let schema = utils::get_schema(env, schema_uid).ok_or(Error::SchemaNotFound)?;
+    if &schema.authority != caller && !is_admin(env, caller) {
+        return Err(Error::NotAuthorized);
+    }
+    Ok(())
+}
+
+pub fn add(env: &Env, caller: Address, schema_uid: BytesN<32>, issuer: Address) -> Result<(), Error> {
+    gestionar(env, &caller, &schema_uid)?;
+    let lista_key = DataKey::IssuerList(schema_uid.clone());
+    let mut lista: Vec<Address> = env.storage().persistent().get(&lista_key).unwrap_or(Vec::new(env));
+    if status(env, &schema_uid, &issuer) == IssuerStatus::NotListed {
+        lista.push_back(issuer.clone());
+    }
+    let key = DataKey::Issuer(schema_uid, issuer);
+    env.storage().persistent().set(&key, &IssuerStatus::Active);
+    env.storage().persistent().set(&lista_key, &lista);
+    utils::bump_persistent(env, &key);
+    utils::bump_persistent(env, &lista_key);
+    Ok(())
+}
+
+pub fn retire(env: &Env, caller: Address, schema_uid: BytesN<32>, issuer: Address) -> Result<(), Error> {
+    gestionar(env, &caller, &schema_uid)?;
+    if status(env, &schema_uid, &issuer) == IssuerStatus::NotListed {
+        return Err(Error::NotAuthorized);
+    }
+    let key = DataKey::Issuer(schema_uid, issuer);
+    env.storage().persistent().set(&key, &IssuerStatus::Retired);
+    utils::bump_persistent(env, &key);
+    Ok(())
+}
+
+pub fn list(env: &Env, schema_uid: &BytesN<32>) -> Vec<Address> {
+    env.storage().persistent().get(&DataKey::IssuerList(schema_uid.clone())).unwrap_or(Vec::new(env))
+}
+
+/// Llamado desde `attest`: restringe solo si el schema tiene lista.
+pub fn check_attest(env: &Env, schema_uid: &BytesN<32>, attester: &Address) -> Result<(), Error> {
+    if !env.storage().persistent().has(&DataKey::IssuerList(schema_uid.clone())) {
+        return Ok(());
+    }
+    if status(env, schema_uid, attester) != IssuerStatus::Active {
+        return Err(Error::IssuerNotActive);
+    }
+    Ok(())
+}
