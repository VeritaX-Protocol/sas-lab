     /// # Returns
     ///
     /// Returns the next expected nonce (`u64`) for the given attester.
+    /// Lab 02: cualquiera puede renovar el TTL de una attestation (y de la instancia) pagando la renta.
+    /// No cambia datos ni requiere autorización: solo gasta la tarifa de quien llama.
+    pub fn extend_attestation_ttl(env: Env, attestation_uid: BytesN<32>) -> Result<(), errors::Error> {
+        let key = state::DataKey::AttestationUID(attestation_uid);
+        if !env.storage().persistent().has(&key) {
+            return Err(errors::Error::AttestationNotFound);
+        }
+        utils::bump_persistent(&env, &key);
+        utils::bump_instance(&env);
+        Ok(())
+    }
+
     pub fn get_attester_nonce(env: Env, attester: Address) -> u64 {
         utils::get_next_nonce(&env, &attester)
     }
